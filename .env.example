GROQ_API_KEY=your_groq_api_key_here

# Postgres is the source of truth for menu/sessions/carts/orders.
# Optional: defaults to localhost:5433 (matches docker-compose.yml's
# host-port mapping, chosen to avoid clashing with a local Postgres on 5432)
DATABASE_URL=postgresql+psycopg://restaurant:restaurant@localhost:5433/restaurant_order_agent

# Redis now only holds per-turn session counters (status/query_count/etc),
# not cart or order data. Optional: defaults to redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Optional: LangSmith tracing (debug errors, per-node latency, token usage).
# Leave LANGSMITH_TRACING unset or "false" to disable - the app runs the
# same either way, this only turns tracing on/off.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=restaurant-order-agent

# Optional: defaults to INFO if unset. One of DEBUG/INFO/WARNING/ERROR/CRITICAL.
LOG_LEVEL=INFO